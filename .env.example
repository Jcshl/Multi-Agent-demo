# Copy to .env and fill in. Never commit .env.

SILICONFLOW_API_KEY=
MODEL_NAME=

# Optional — MySQL（账号 Agent）
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=genshin_ai
# DEFAULT_PLAYER_UID=
# 默认即 users / characters / uid；若你的列名不同可覆盖：
# MYSQL_TABLE_PLAYERS=users
# MYSQL_TABLE_CHARACTERS=characters
# MYSQL_COL_PLAYER_UID=uid
# MYSQL_COL_RESIN=resin
# MYSQL_COL_GOAL=goal
# MYSQL_COL_CHARACTER_NAME=name
# MULTI_AGENT_ROUTE_MODE=llm
#   llm（默认）| heuristic | game | account | casual — 后三项强制固定路由便于调试

# Optional — 会话记忆（提纲摘要 SQLite）
# MEMORY_DB_PATH=./data/session_memory.sqlite
# MEMORY_RECALL_LAST_N=5
# 跨 specialist 指代消解（用路由模型把「刚才算的数」等改写成显式实体；默认开启）
# MEMORY_EXPAND_CONTEXT=1
# MEMORY_EXPAND_MAX_ROUNDS=24
# 本会话全局轮次注入各 specialist（跨路由共享「短期」视图；默认开启）
# MEMORY_SESSION_RECAP=1
# MEMORY_SESSION_RECAP_ROUNDS=20

# Optional
# HF_ENDPOINT=https://hf-mirror.com
# RAG_EMBEDDING_MODEL_PATH=
# RAG_TOP_K=8
# RAG_CHUNK_SIZE=300
# RAG_CHUNK_OVERLAP=50
# LLM_REQUEST_TIMEOUT=120
